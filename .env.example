# TKPL Portal Environment Configuration
# Copy this file to .env.local and fill in your Supabase project credentials.
# Never put the Supabase service_role secret key in frontend variables!

# --- Browser (safe to expose) ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here

# --- Server only (Vercel Environment Variables / `vercel dev`). NEVER prefix with VITE_ ---
# Razorpay dashboard -> Settings -> API Keys (start in TEST mode).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Supabase project URL and the service_role key (Project Settings -> API).
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
